{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@saferide/shared/*": ["shared/src/*"],
      "@saferide/client/*": ["client/src/*"],
      "@saferide/server/*": ["server/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
