# SafeRide PU - Production Environment Variables Example
# Copy this to your Render/Vercel/Koyeb dashboard environment settings

# Server Environment
NODE_ENV=production
PORT=5000

# Client Application URL (Comma-separated for multiple allowed origins)
# Example: https://saferide-pu.vercel.app,https://saferide-backend.onrender.com
CLIENT_URL=https://saferide-pu.vercel.app

# Database - MongoDB Atlas (Free M0 Cluster hosted in AWS Mumbai ap-south-1)
# Sign up at https://www.mongodb.com/atlas/database
MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@cluster0.xxxxx.mongodb.net/saferide?retryWrites=true&w=majority&appName=SafeRidePU

# JWT Security Secrets (Generate using: openssl rand -base64 32)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Razorpay Credentials (Leave placeholder for sandbox testing mode, or use live keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# AI Transit Engine (Optional: Gemini API key for dynamic AI chat, fallback runs free locally)
GEMINI_API_KEY=

# Institutional Security Hotline
SECURITY_DESK_PHONE=+91 2668 260300
AMBULANCE_PHONE=+91 2668 260222
